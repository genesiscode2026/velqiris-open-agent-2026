# VELQIRIS Open Agent 2026 Environment Configuration

# Data Layer: Zetaris Platform
ZETARIS_REST_URL=http://localhost:3000
ZETARIS_API_KEY=your_zetaris_api_bearer_token_here
ZETARIS_ORG_ID=your_current_zetaris_org_id

# Power Layer: NVIDIA Nemotron via Meterless or NVIDIA API
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_API_KEY=your_current_model_api_key_here
NEMOTRON_MODEL=exact_current_model_id

# Governance: Meterless Telemetry
METERLESS_ENABLED=false
METERLESS_PROMPT_ID=market_truth_explain_why
COST_PER_QUERY_LIMIT_USD=0.05

# Institutional Safety
FAIL_CLOSED=true
METERLESS_STORE_PATH=.velqiris/hmem
